# Copy to .env and set strong local values before `docker compose up`.
# .env is gitignored — never commit real secrets.
#
# These values are for local development only. Rotate anything that was ever
# committed historically (see issue SEC-01).

NAKAMA_CONSOLE_USERNAME=local_dev_admin
NAKAMA_CONSOLE_PASSWORD=replace_with_strong_local_password
NAKAMA_CONSOLE_SIGNING_KEY=replace_with_long_random_signing_key
NAKAMA_RUNTIME_HTTP_KEY=replace_with_long_random_http_key
