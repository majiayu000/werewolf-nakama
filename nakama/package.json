{
  "name": "werewolf-nakama",
  "version": "1.0.0",
  "description": "Werewolf game server running on Nakama",
  "main": "build/index.js",
  "scripts": {
    "build": "npx esbuild src/main.ts --bundle --outfile=build/index.js --format=cjs --target=es2020 --keep-names --external:nakama-runtime && node scripts/postbuild.js",
    "build:watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": ["werewolf", "mafia", "nakama", "game-server"],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
